rules_version = '2';

// Regras do banco (Firestore) do excellentreading.
// Cada pessoa só pode ler e gravar o que está dentro de users/{o próprio id}.
// Cole este conteúdo em: Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
